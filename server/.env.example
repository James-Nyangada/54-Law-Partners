# ---------------------------------------------------------------------------
# 54 Law Partners — backend environment
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and
# must never be committed.
#
#   cp .env.example .env
#
# Everything marked FILL IN is something you provide. Everything else has a
# working default.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Where the admin dashboard (3001) and the public site (3000) run. Comma-separated.
# These are the only origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# --- MongoDB ----------------------------------------------------------------
# FILL IN. From MongoDB Atlas: Database > Connect > Drivers.
# Local alternative: mongodb://127.0.0.1:27017/54lp
MONGODB_URI=

# --- Authentication ---------------------------------------------------------
# FILL IN both. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT values. Never reuse them between environments.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookie domain for the refresh token. Leave blank in development.
# In production set it to your domain, e.g. .54partners.org
COOKIE_DOMAIN=

# --- Cloudinary -------------------------------------------------------------
# FILL IN all three. From the Cloudinary console dashboard.
# The API secret stays here on the server. It is never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Root folder inside the Cloudinary account. Sub-folders are created under it.
CLOUDINARY_ROOT_FOLDER=54lp

# --- First admin user -------------------------------------------------------
# FILL IN. Used once by `npm run seed` to create the first login.
# Change the password immediately after the first sign-in, then you may
# blank these out.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Uploads ----------------------------------------------------------------
MAX_IMAGE_MB=8
MAX_DOCUMENT_MB=20

# --- Data retention ---------------------------------------------------------
# Days after which enquiries and job applications are flagged for deletion.
# The firm decides this figure; it must match the published privacy policy.
# 0 disables the flag.
ENQUIRY_RETENTION_DAYS=0
APPLICATION_RETENTION_DAYS=0
