# ---------------------------------------------------------------------------
# 54 Law Partners — admin dashboard environment
#
#   cp .env.example .env.local
#
# Only NEXT_PUBLIC_-prefixed variables reach the browser, and they are compiled
# into the JavaScript at build time — change them, then rebuild. Never put a
# secret here: anything in this file is visible to anyone who opens the page.
# The Cloudinary secret and the JWT secrets live in the server's .env.
# ---------------------------------------------------------------------------

# Where the Express API is running, including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Shown in the browser tab and the sidebar.
NEXT_PUBLIC_APP_NAME=54 Law Partners
